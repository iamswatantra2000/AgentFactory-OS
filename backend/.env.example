NODE_ENV=development
LOG_LEVEL=info
API_GATEWAY_PORT=4000
IDENTITY_SERVICE_PORT=4001
ENTITLEMENT_SERVICE_PORT=4002
PROJECT_SERVICE_PORT=4003
IDENTITY_SERVICE_URL=http://localhost:4001
ENTITLEMENT_SERVICE_URL=http://localhost:4002
PROJECT_SERVICE_URL=http://localhost:4003
PROJECT_SERVICE_INTERNAL_TOKEN=local-development-only-token
PROJECT_LIMIT=5
ALLOWED_ORIGINS=http://localhost:3000
IDENTITY_DATABASE_URL=postgresql://agentfactory_identity:identity_dev_only@localhost:55432/agentfactory_identity
APP_BASE_URL=http://localhost:3000
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_FROM=AgentFactory OS <hello@agentfactory.local>
# Set these only after creating provider registrations. Never commit real secrets.
