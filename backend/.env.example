# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
ENTITLEMENT_DATABASE_URL=postgresql://agentfactory_entitlement:entitlement_dev_only@localhost:55432/agentfactory_entitlement
PROJECT_DATABASE_URL=postgresql://agentfactory_project:project_dev_only@localhost:55432/agentfactory_project
TEST_CHECKOUT_ENABLED=true
