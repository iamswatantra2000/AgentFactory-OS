{
  "name": "@agentfactory/entitlement-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "start": "node dist/index.js",
    "lint": "eslint src test prisma.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@agentfactory/observability": "workspace:*",
    "@prisma/client": "7.10.1",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@agentfactory/typescript-config": "workspace:*",
    "@types/express": "5.0.6",
    "dotenv": "18.0.8",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
