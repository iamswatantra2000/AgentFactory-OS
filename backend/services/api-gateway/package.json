    "@as-integrations/express5": "1.1.2",
    "cors": "2.8.6",
    "express": "5.3.0",
    "graphql": "17.0.2",
    "helmet": "8.3.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@agentfactory/typescript-config": "workspace:*",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "tsx": "4.23.15",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
